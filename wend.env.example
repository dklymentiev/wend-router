# Copy to wend.env and fill in the keys you have. Never commit wend.env.

# Groq: https://console.groq.com/keys (no card)
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys (no card; free models 50 requests/day)
OPENROUTER_API_KEY=
# NVIDIA NIM: https://build.nvidia.com (no card; evaluation use only)
NVIDIA_API_KEY=
# SambaNova: https://cloud.sambanova.ai/apis (as of 2026-10-22 needs a card on file)
SAMBANOVA_API_KEY=
# Cloudflare Workers AI: token with "Workers AI" permission, plus the account id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Gemini: https://aistudio.google.com/apikey (free tier trains on prompts)
GEMINI_API_KEY=
# Mistral: https://console.mistral.ai (as of 2026-10-22 a free account gets an API limit of 0)
MISTRAL_API_KEY=

# ROUTER_ALLOW_TRAINING=0   skip providers whose free tier may train on prompts
